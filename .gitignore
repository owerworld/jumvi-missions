.DS_Store
node_modules/
.wrangler/
.dev.vars*

# tools/jumvi-mission-factory.mjs run artifacts — every run writes a full
# record to artifacts/mission-runs/<RUN_ID>/ for human review, but these are
# working files (LLM generations, revision rounds, structured JSON, deploy
# results), not source. Never committed; see docs/JUMVI_MISSION_FACTORY.md.
artifacts/mission-runs/*/
!artifacts/mission-runs/.gitkeep

# Isolated implementation artifacts
dist/
node_modules/

.test-results/
playwright-report/

dist-v2/
.test-v2/

# Local editable SVG masters are retained with source hashes; deploy uses WebP derivatives.
artifacts/presentation-catalog-v3/*.svg
