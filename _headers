/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net https://unpkg.com https://cdnjs.cloudflare.com https://static.cloudflareinsights.com/beacon.min.js https://static.cloudflareinsights.com/beacon.min.js/; worker-src 'self' blob: https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self' blob: https://cdn.jsdelivr.net; frame-ancestors 'self'; base-uri 'self'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# §5.2 — Cache policy.
#
# "immutable" is ONLY correct for a URL whose content can never change, i.e. one
# carrying a version. Scripts and styles are always requested with ?v=YYYYMMDD-NN
# (Cloudflare folds the query into the edge cache key), so those stay immutable.
#
# Everything under /assets, /icons and /vendor is referenced WITHOUT a version —
# deliberately, because the service worker precaches those exact literal paths and
# a ?v= would stop the precache from ever matching. Marking them immutable meant a
# changed logo/sprite/model could never reach a returning visitor: the browser
# would not even revalidate for a year. (Coach Leo's model hit exactly this — his
# GLB changed at a static URL and served stale.) They get a short max-age plus
# stale-while-revalidate instead: still instant from cache, still fully offline via
# the service worker, but a change propagates within a day.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/vendor/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Versioned by ?v= on every reference — safe to freeze.
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/service-worker.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

# Same reasoning as /manifest.json above, for the Turkish route. The rule has
# to be spelled out: _headers matches exact paths, so /tr/manifest.json does
# NOT inherit the /manifest.json rule, and the Turkish manifest is referenced
# without a ?v= — an updated one could otherwise sit stale on the device.
/tr/manifest.json
  Cache-Control: public, max-age=0, must-revalidate
