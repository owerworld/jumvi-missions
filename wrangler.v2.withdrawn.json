{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jumvi-missions-v2-review",
  "main": "src/v2-withdrawn-route-worker.mjs",
  "compatibility_date": "2026-09-24",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "https://qr.jumvi.co/v2*",
      "zone_name": "jumvi.co"
    }
