{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jumvi-v2-legacy-compat",
  "main": "src/v2-legacy-compat-worker.mjs",
  "compatibility_date": "2026-09-24",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "https://qr.jumvi.co/service-worker.js*",
      "zone_name": "jumvi.co"
    }
  ],
  "assets": {
    "directory": "artifacts/v2-legacy-compat",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "analytics_engine_datasets": [],
  "observability": {
    "enabled": false
  }
}
